# ---- Auth ---------------------------------------------------------------
# Login password (also editable from /settings). If unset, the app falls
# back to whatever was stored in the DB, then to "admin".
ADMIN_PASSWORD=target-admin

# ---- Encryption ----------------------------------------------------------
# 64 hex chars recommended. If unset, a random key is generated on first run
# and stored in the DB (so the DB is only decryptable on this machine/instance).
ENCRYPTION_KEY=

# ---- Usage logging --------------------------------------------------------
# Bearer token your scripts must send to POST /api/usage/log
USAGE_LOG_BEARER=tam-usage-log-token

# ---- Database --------------------------------------------------------------
DB_PATH=./data/tam.sqlite

# ---- Scheduling / timezone ---------------------------------------------------
TIMEZONE=Asia/Dhaka
CHECK_INTERVAL_MINUTES=10
KAGGLE_POLL_MINUTES=3

# ---- Alerts ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_ON_KEY_DEAD=1

# ---- Kaggle API -----------------------------------------------------------
# Custom base if you ever need to override (normally leave empty)
KAGGLE_API_BASE=

# ---- Plexus endpoint (GPU Ollama tunnel published to Supabase) ------------
# The notebook (Script 2) publishes its current tunnel URL into a Supabase
# table "plexus_endpoint" (row id=1). Filled from /settings too.
PLEXUS_SUPABASE_URL=
PLEXUS_SUPABASE_KEY=
PLEXUS_TOKEN=PLEXUS_KAGGLE_2026